#include <cstdint>
#include "c_api/asc_simd.h"

#define ROW_ELEMS 2048u

__simd_vf__ inline void swi_glu_vf(__ubuf__ float* dst, __ubuf__ float* src0,
                                   __ubuf__ float* src1, uint32_t len)
{
    const uint32_t vf_len = (uint32_t)asc_get_vf_len();
    const uint32_t vf_elems = vf_len / 4u;
    const uint32_t vecs = len / vf_elems;
    for (uint32_t iv = 0u; iv < vecs; ++iv) {
        uint32_t data_len = vf_elems;
        vector_bool vmask = asc_update_mask_b32(data_len);
        vector_float a;
        asc_load(a, src0 + iv * vf_elems);
        vector_float b;
        asc_load(b, src1 + iv * vf_elems);
        vector_float n;
        asc_neg(n, a, vmask);
        vector_float e;
        asc_exp(e, n, vmask);
        vector_float d;
        asc_add_scalar(d, e, 1.0f, vmask);
        vector_float one;
        asc_duplicate_scalar(one, 1.0f, vmask);
        vector_float sa;
        asc_div(sa, one, d, vmask);
        vector_float g;
        asc_mul(g, a, sa, vmask);
        vector_float y;
        asc_mul(y, g, b, vmask);
        asc_store(dst + iv * vf_elems, y);
    }
}

__vector__ __global__ __aicore__ void swi_glu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    const uint32_t rows = 2048u;
    __ubuf__ float x0_buf[ROW_ELEMS];
    __ubuf__ float x1_buf[ROW_ELEMS];
    __ubuf__ float out_buf[ROW_ELEMS];
    for (uint32_t r = 0u; r < rows; ++r) {
        const uint32_t xrow = r * 4096u;
        asc_copy_gm2ub(x0_buf, x + xrow, ROW_ELEMS * 4u);
        asc_copy_gm2ub(x1_buf, x + xrow + ROW_ELEMS, ROW_ELEMS * 4u);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        swi_glu_vf(out_buf, x0_buf, x1_buf, ROW_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + r * ROW_ELEMS, out_buf, ROW_ELEMS * 4u);
        asc_sync_pipe(PIPE_ALL);
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

#define TILE_ELEMS 4096u

__simd_vf__ inline void sigmoid_vf(__ubuf__ float* dst, __ubuf__ float* src, uint32_t len)
{
    const uint32_t vf_len = (uint32_t)asc_get_vf_len();
    const uint32_t vf_elems = vf_len / 4u;
    const uint32_t vecs = len / vf_elems;
    for (uint32_t iv = 0u; iv < vecs; ++iv) {
        uint32_t data_len = vf_elems;
        vector_bool vmask = asc_update_mask_b32(data_len);
        vector_float v;
        asc_load(v, src + iv * vf_elems);
        vector_float n;
        asc_neg(n, v, vmask);
        vector_float e;
        asc_exp(e, n, vmask);
        vector_float d;
        asc_add_scalar(d, e, 1.0f, vmask);
        vector_float one;
        asc_duplicate_scalar(one, 1.0f, vmask);
        vector_float y;
        asc_div(y, one, d, vmask);
        asc_store(dst + iv * vf_elems, y);
    }
}

__vector__ __global__ __aicore__ void sigmoid_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    const uint32_t total = 4194304u;
    __ubuf__ float in_buf[TILE_ELEMS];
    __ubuf__ float out_buf[TILE_ELEMS];
    for (uint32_t base = 0u; base < total; base += TILE_ELEMS) {
        asc_copy_gm2ub(in_buf, x + base, TILE_ELEMS * 4u);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        sigmoid_vf(out_buf, in_buf, TILE_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + base, out_buf, TILE_ELEMS * 4u);
        asc_sync_pipe(PIPE_ALL);
    }
}

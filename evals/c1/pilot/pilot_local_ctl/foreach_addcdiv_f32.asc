#include <cstdint>
#include "c_api/asc_simd.h"

#define TILE_ELEMS 4096u

__simd_vf__ inline void addcdiv_vf(__ubuf__ float* dst, __ubuf__ float* src1,
                                   __ubuf__ float* src2, __ubuf__ float* src3, uint32_t len)
{
    const uint32_t vf_len = (uint32_t)asc_get_vf_len();
    const uint32_t vf_elems = vf_len / 4u;
    const uint32_t vecs = len / vf_elems;
    for (uint32_t iv = 0u; iv < vecs; ++iv) {
        uint32_t data_len = vf_elems;
        vector_bool vmask = asc_update_mask_b32(data_len);
        vector_float a;
        asc_load(a, src1 + iv * vf_elems);
        vector_float b;
        asc_load(b, src2 + iv * vf_elems);
        vector_float c;
        asc_load(c, src3 + iv * vf_elems);
        vector_float q;
        asc_div(q, b, c, vmask);
        vector_float y;
        asc_add(y, a, q, vmask);
        asc_store(dst + iv * vf_elems, y);
    }
}

__vector__ __global__ __aicore__ void foreach_addcdiv_f32(__gm__ float* x1, __gm__ float* x2,
                                                          __gm__ float* x3, __gm__ float* z)
{
    asc_init();
    const uint32_t total = 2097152u;
    __ubuf__ float x1_buf[TILE_ELEMS];
    __ubuf__ float x2_buf[TILE_ELEMS];
    __ubuf__ float x3_buf[TILE_ELEMS];
    __ubuf__ float out_buf[TILE_ELEMS];
    for (uint32_t base = 0u; base < total; base += TILE_ELEMS) {
        asc_copy_gm2ub(x1_buf, x1 + base, TILE_ELEMS * 4u);
        asc_copy_gm2ub(x2_buf, x2 + base, TILE_ELEMS * 4u);
        asc_copy_gm2ub(x3_buf, x3 + base, TILE_ELEMS * 4u);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        addcdiv_vf(out_buf, x1_buf, x2_buf, x3_buf, TILE_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + base, out_buf, TILE_ELEMS * 4u);
        asc_sync_pipe(PIPE_ALL);
    }
}

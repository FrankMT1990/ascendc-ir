#include "c_api/asc_simd.h"

__vector__ __global__ __aicore__ void bad_offlist(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();
    __ubuf__ float buf_x[2048];
    __ubuf__ float buf_y[2048];
    __ubuf__ float buf_z[2048];
    asc_copy_gm2ub(buf_x, x, 1, 8192, 0, 0);
    asc_copy_gm2ub(buf_y, y, 1, 8192, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    vector_bool vmask;
    vector_float rx;
    vector_float ry;
    vector_float rz;
    vmask = asc_update_mask_b32(2048);
    asc_load(rx, buf_x);
    asc_load(ry, buf_y);
    asc_axpy(rz, rx, ry, 1.0f, vmask);
    asc_store(buf_z, rz);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z, buf_z, 1, 8192, 0, 0);
}

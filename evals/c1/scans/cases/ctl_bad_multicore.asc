#include "c_api/asc_simd.h"

__vector__ __global__ __aicore__ void bad_multicore(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    uint32_t blocks = asc_get_block_num();
    uint32_t bid = asc_get_block_idx();
    __ubuf__ float buf[2048];
    if (bid < blocks) {
        asc_copy_gm2ub(buf, x + bid * 2048, 1, 8192, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_copy_ub2gm(z + bid * 2048, buf, 1, 8192, 0, 0);
    }
}

#include "c_api/asc_simd.h"

__simd_vf__ inline void or_vf(
    __ubuf__ float* x_local, __ubuf__ float* z_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;
    vector_bool vmask;
    vector_float reg_src;
    vector_float reg_dst;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(reg_src, x_local + i * one_rep_size);
        asc_or(reg_dst, reg_src, reg_src, vmask);
        asc_store(z_local + i * one_rep_size, reg_dst);
    }
}

__vector__ __global__ __aicore__ void ctl_ok_vector(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float buf_0[2048];
    __ubuf__ float buf_1[2048];
    asc_copy_gm2ub(buf_0, x, 1, 8192, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    or_vf(buf_0, buf_1, 2048);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z, buf_1, 1, 8192, 0, 0);
}

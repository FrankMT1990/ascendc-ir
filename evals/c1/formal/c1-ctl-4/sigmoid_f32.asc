#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t SIG_TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t SIG_CHUNK_ELEMS = 8192u;
constexpr uint32_t SIG_CHUNK_BYTES = SIG_CHUNK_ELEMS * static_cast<uint32_t>(sizeof(float));

__simd_vf__ inline void sigmoid_f32_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                       uint32_t elem_count, uint32_t vf_elems)
{
    uint32_t blocks = elem_count / vf_elems;
    uint32_t remain = elem_count;
    vector_float x_reg;
    vector_float nx_reg;
    vector_float e_reg;
    vector_float ep1_reg;
    vector_float one_reg;
    vector_float y_reg;
    for (uint32_t b = 0; b < blocks; ++b) {
        vector_bool vmask = asc_update_mask_b32(remain);
        asc_load(x_reg, src + b * vf_elems);
        asc_neg(nx_reg, x_reg, vmask);
        asc_exp(e_reg, nx_reg, vmask);
        asc_add_scalar(ep1_reg, e_reg, 1.0f, vmask);
        asc_duplicate_scalar(one_reg, 1.0f, vmask);
        asc_div(y_reg, one_reg, ep1_reg, vmask);
        asc_store(dst + b * vf_elems, y_reg);
    }
}

__vector__ __global__ __aicore__ void sigmoid_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    const uint32_t vf_elems = static_cast<uint32_t>(asc_get_vf_len() / sizeof(float));
    __ubuf__ float x_local[SIG_CHUNK_ELEMS];
    __ubuf__ float z_local[SIG_CHUNK_ELEMS];
    for (uint32_t off = 0; off < SIG_TOTAL_ELEMS; off += SIG_CHUNK_ELEMS) {
        asc_copy_gm2ub(x_local, x + off, SIG_CHUNK_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        sigmoid_f32_vf(z_local, x_local, SIG_CHUNK_ELEMS, vf_elems);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + off, z_local, SIG_CHUNK_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

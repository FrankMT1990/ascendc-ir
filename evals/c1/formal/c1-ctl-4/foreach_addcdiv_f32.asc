#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t FA_TOTAL_ELEMS = 2u * 1024u * 1024u;
constexpr uint32_t FA_CHUNK_ELEMS = 8192u;
constexpr uint32_t FA_CHUNK_BYTES = FA_CHUNK_ELEMS * static_cast<uint32_t>(sizeof(float));

__simd_vf__ inline void foreach_addcdiv_f32_vf(__ubuf__ float* dst, __ubuf__ float* src1,
                                               __ubuf__ float* src2, __ubuf__ float* src3,
                                               uint32_t elem_count, uint32_t vf_elems)
{
    uint32_t blocks = elem_count / vf_elems;
    uint32_t remain = elem_count;
    vector_float a_reg;
    vector_float b_reg;
    vector_float c_reg;
    vector_float q_reg;
    vector_float s_reg;
    vector_float y_reg;
    for (uint32_t b = 0; b < blocks; ++b) {
        vector_bool vmask = asc_update_mask_b32(remain);
        asc_load(a_reg, src1 + b * vf_elems);
        asc_load(b_reg, src2 + b * vf_elems);
        asc_load(c_reg, src3 + b * vf_elems);
        asc_div(q_reg, b_reg, c_reg, vmask);
        asc_mul_scalar(s_reg, q_reg, 1.0f, vmask);
        asc_add(y_reg, a_reg, s_reg, vmask);
        asc_store(dst + b * vf_elems, y_reg);
    }
}

__vector__ __global__ __aicore__ void foreach_addcdiv_f32(__gm__ float* x1, __gm__ float* x2,
                                                          __gm__ float* x3, __gm__ float* z)
{
    asc_init();
    const uint32_t vf_elems = static_cast<uint32_t>(asc_get_vf_len() / sizeof(float));
    __ubuf__ float x1_local[FA_CHUNK_ELEMS];
    __ubuf__ float x2_local[FA_CHUNK_ELEMS];
    __ubuf__ float x3_local[FA_CHUNK_ELEMS];
    __ubuf__ float z_local[FA_CHUNK_ELEMS];
    for (uint32_t off = 0; off < FA_TOTAL_ELEMS; off += FA_CHUNK_ELEMS) {
        asc_copy_gm2ub(x1_local, x1 + off, FA_CHUNK_BYTES);
        asc_copy_gm2ub(x2_local, x2 + off, FA_CHUNK_BYTES);
        asc_copy_gm2ub(x3_local, x3 + off, FA_CHUNK_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        foreach_addcdiv_f32_vf(z_local, x1_local, x2_local, x3_local, FA_CHUNK_ELEMS, vf_elems);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + off, z_local, FA_CHUNK_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

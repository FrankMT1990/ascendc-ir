#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t SG_ROWS = 2048u;
constexpr uint32_t SG_COLS = 4096u;
constexpr uint32_t SG_HALF = 2048u;
constexpr uint32_t SG_CHUNK_ROWS = 2u;
constexpr uint32_t SG_CHUNK_ELEMS = SG_CHUNK_ROWS * SG_COLS;
constexpr uint32_t SG_IN_BYTES = SG_CHUNK_ELEMS * static_cast<uint32_t>(sizeof(float));
constexpr uint32_t SG_OUT_ELEMS = SG_CHUNK_ROWS * SG_HALF;
constexpr uint32_t SG_OUT_BYTES = SG_OUT_ELEMS * static_cast<uint32_t>(sizeof(float));
constexpr uint32_t SG_CHUNKS = SG_ROWS / SG_CHUNK_ROWS;

__simd_vf__ inline void swi_glu_f32_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                       uint32_t rows, uint32_t row_cols, uint32_t half_cols,
                                       uint32_t out_elems, uint32_t vf_elems)
{
    uint32_t blocks_per_row = half_cols / vf_elems;
    uint32_t remain = out_elems;
    vector_float x0_reg;
    vector_float x1_reg;
    vector_float nx_reg;
    vector_float e_reg;
    vector_float ep1_reg;
    vector_float one_reg;
    vector_float sg_reg;
    vector_float gx_reg;
    vector_float y_reg;
    for (uint32_t r = 0; r < rows; ++r) {
        for (uint32_t b = 0; b < blocks_per_row; ++b) {
            vector_bool vmask = asc_update_mask_b32(remain);
            asc_load(x0_reg, src + r * row_cols + b * vf_elems);
            asc_load(x1_reg, src + r * row_cols + half_cols + b * vf_elems);
            asc_neg(nx_reg, x0_reg, vmask);
            asc_exp(e_reg, nx_reg, vmask);
            asc_add_scalar(ep1_reg, e_reg, 1.0f, vmask);
            asc_duplicate_scalar(one_reg, 1.0f, vmask);
            asc_div(sg_reg, one_reg, ep1_reg, vmask);
            asc_mul(gx_reg, x0_reg, sg_reg, vmask);
            asc_mul(y_reg, gx_reg, x1_reg, vmask);
            asc_store(dst + r * half_cols + b * vf_elems, y_reg);
        }
    }
}

__vector__ __global__ __aicore__ void swi_glu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    const uint32_t vf_elems = static_cast<uint32_t>(asc_get_vf_len() / sizeof(float));
    __ubuf__ float in_local[SG_CHUNK_ELEMS];
    __ubuf__ float out_local[SG_OUT_ELEMS];
    for (uint32_t c = 0; c < SG_CHUNKS; ++c) {
        asc_copy_gm2ub(in_local, x + c * SG_CHUNK_ELEMS, SG_IN_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        swi_glu_f32_vf(out_local, in_local, SG_CHUNK_ROWS, SG_COLS, SG_HALF, SG_OUT_ELEMS,
                       vf_elems);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + c * SG_OUT_ELEMS, out_local, SG_OUT_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

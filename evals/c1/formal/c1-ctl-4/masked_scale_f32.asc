#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t MS_TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t MS_CHUNK_ELEMS = 8192u;
constexpr uint32_t MS_CHUNK_BYTES = MS_CHUNK_ELEMS * static_cast<uint32_t>(sizeof(float));
constexpr uint32_t MS_PRED_CHUNK_BYTES = MS_CHUNK_ELEMS / 2u;
constexpr uint32_t MS_PRED_CHUNK_U32 = MS_PRED_CHUNK_BYTES / 4u;

__simd_vf__ inline void masked_scale_f32_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                            __ubuf__ uint32_t* pred_src, uint32_t elem_count,
                                            uint32_t vf_elems, uint32_t mask_rep)
{
    uint32_t blocks = elem_count / vf_elems;
    uint32_t remain = elem_count;
    vector_float x_reg;
    vector_float zero_reg;
    vector_float y_reg;
    for (uint32_t b = 0; b < blocks; ++b) {
        vector_bool vmask = asc_update_mask_b32(remain);
        vector_bool pred;
        asc_load(x_reg, src + b * vf_elems);
        asc_loadalign_postupdate(pred, pred_src, static_cast<int32_t>(mask_rep));
        asc_duplicate_scalar(zero_reg, 0.0f, vmask);
        asc_select(y_reg, x_reg, zero_reg, pred);
        asc_store(dst + b * vf_elems, y_reg);
    }
}

__vector__ __global__ __aicore__ void masked_scale_f32(__gm__ float* x, __gm__ uint8_t* mask,
                                                       __gm__ float* z)
{
    asc_init();
    const uint32_t vf_elems = static_cast<uint32_t>(asc_get_vf_len() / sizeof(float));
    const uint32_t mask_rep = static_cast<uint32_t>(asc_get_vf_len() / 8u);
    __ubuf__ float x_local[MS_CHUNK_ELEMS];
    __ubuf__ uint32_t pred_local[MS_PRED_CHUNK_U32];
    __ubuf__ float z_local[MS_CHUNK_ELEMS];
    for (uint32_t off = 0; off < MS_TOTAL_ELEMS; off += MS_CHUNK_ELEMS) {
        asc_copy_gm2ub(x_local, x + off, MS_CHUNK_BYTES);
        asc_copy_gm2ub(pred_local, mask + off / 2u, MS_PRED_CHUNK_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        masked_scale_f32_vf(z_local, x_local, pred_local, MS_CHUNK_ELEMS, vf_elems, mask_rep);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + off, z_local, MS_CHUNK_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t GELU_TOTAL_ELEMS = 8192u * 8192u;
constexpr uint32_t GELU_CHUNK_ELEMS = 8192u;
constexpr uint32_t GELU_CHUNK_BYTES = GELU_CHUNK_ELEMS * static_cast<uint32_t>(sizeof(float));

__simd_vf__ inline void gelu_f32_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                    uint32_t elem_count, uint32_t vf_elems)
{
    uint32_t blocks = elem_count / vf_elems;
    uint32_t remain = elem_count;
    vector_float x_reg;
    vector_float sq_reg;
    vector_float cu_reg;
    vector_float c3_reg;
    vector_float inner_reg;
    vector_float t_reg;
    vector_float u_reg;
    vector_float eu_reg;
    vector_float den_reg;
    vector_float two_reg;
    vector_float q_reg;
    vector_float one_reg;
    vector_float th_reg;
    vector_float op_reg;
    vector_float hx_reg;
    vector_float y_reg;
    for (uint32_t b = 0; b < blocks; ++b) {
        vector_bool vmask = asc_update_mask_b32(remain);
        asc_load(x_reg, src + b * vf_elems);
        asc_mul(sq_reg, x_reg, x_reg, vmask);
        asc_mul(cu_reg, sq_reg, x_reg, vmask);
        asc_mul_scalar(c3_reg, cu_reg, 0.044715f, vmask);
        asc_add(inner_reg, c3_reg, x_reg, vmask);
        asc_mul_scalar(t_reg, inner_reg, 0.7978845608f, vmask);
        asc_add(u_reg, t_reg, t_reg, vmask);
        asc_exp(eu_reg, u_reg, vmask);
        asc_add_scalar(den_reg, eu_reg, 1.0f, vmask);
        asc_duplicate_scalar(two_reg, 2.0f, vmask);
        asc_div(q_reg, two_reg, den_reg, vmask);
        asc_duplicate_scalar(one_reg, 1.0f, vmask);
        asc_sub(th_reg, one_reg, q_reg, vmask);
        asc_add(op_reg, one_reg, th_reg, vmask);
        asc_mul_scalar(hx_reg, x_reg, 0.5f, vmask);
        asc_mul(y_reg, hx_reg, op_reg, vmask);
        asc_store(dst + b * vf_elems, y_reg);
    }
}

__vector__ __global__ __aicore__ void gelu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    const uint32_t vf_elems = static_cast<uint32_t>(asc_get_vf_len() / sizeof(float));
    __ubuf__ float x_local[GELU_CHUNK_ELEMS];
    __ubuf__ float z_local[GELU_CHUNK_ELEMS];
    for (uint32_t off = 0; off < GELU_TOTAL_ELEMS; off += GELU_CHUNK_ELEMS) {
        asc_copy_gm2ub(x_local, x + off, GELU_CHUNK_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        gelu_f32_vf(z_local, x_local, GELU_CHUNK_ELEMS, vf_elems);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + off, z_local, GELU_CHUNK_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

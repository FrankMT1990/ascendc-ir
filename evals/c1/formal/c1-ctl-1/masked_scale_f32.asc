#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t TILE_ELEMS = 8192u;
constexpr uint32_t TILE_BYTES = TILE_ELEMS * sizeof(float);
constexpr uint32_t TILE_NUM = TOTAL_ELEMS / TILE_ELEMS;
constexpr uint32_t MASK_TILE_BYTES = TILE_ELEMS / 2u;
constexpr uint32_t MASK_TILE_UINT32 = MASK_TILE_BYTES / 4u;

__simd_vf__ inline void masked_scale_f32_vf(__ubuf__ float* x_local, __ubuf__ uint32_t* mask_local,
                                            __ubuf__ float* z_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t mask_rep_size = asc_get_vf_len() / 8;
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask;
    vector_bool pred;
    vector_float x_reg;
    vector_float zero_reg;
    vector_float z_reg;
    __ubuf__ uint32_t* mp = mask_local;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(x_reg, x_local + i * one_rep_size);
        asc_loadalign_postupdate(pred, mp, mask_rep_size);
        asc_duplicate_scalar(zero_reg, 0.0f, vmask);
        asc_select(z_reg, x_reg, zero_reg, pred);
        asc_store(z_local + i * one_rep_size, z_reg);
    }
}

__vector__ __global__ __aicore__ void masked_scale_f32(__gm__ float* x, __gm__ uint8_t* mask, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x_local[TILE_ELEMS];
    __ubuf__ uint32_t mask_local[MASK_TILE_UINT32];
    __ubuf__ float z_local[TILE_ELEMS];
    for (uint32_t t = 0; t < TILE_NUM; ++t) {
        asc_copy_gm2ub(x_local, x + t * TILE_ELEMS, TILE_BYTES);
        asc_copy_gm2ub(mask_local, mask + t * MASK_TILE_BYTES, MASK_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        masked_scale_f32_vf(x_local, mask_local, z_local, TILE_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + t * TILE_ELEMS, z_local, TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t ROWS = 2048u;
constexpr uint32_t FULL_COL = 4096u;
constexpr uint32_t HALF_COL = 2048u;
constexpr uint32_t GROUP_ROWS = 4u;
constexpr uint32_t GROUP_NUM = ROWS / GROUP_ROWS;
constexpr uint32_t TILE_ELEMS = HALF_COL * GROUP_ROWS;
constexpr uint32_t HALF_BYTES = HALF_COL * sizeof(float);

__simd_vf__ inline void swi_glu_f32_vf(__ubuf__ float* x0_local, __ubuf__ float* x1_local,
                                       __ubuf__ float* z_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask;
    vector_float x0_reg;
    vector_float x1_reg;
    vector_float t_reg;
    vector_float w_reg;
    vector_float c_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(x0_reg, x0_local + i * one_rep_size);
        asc_load(x1_reg, x1_local + i * one_rep_size);
        asc_neg(t_reg, x0_reg, vmask);
        asc_exp(w_reg, t_reg, vmask);
        asc_add_scalar(t_reg, w_reg, 1.0f, vmask);
        asc_duplicate_scalar(c_reg, 1.0f, vmask);
        asc_div(w_reg, c_reg, t_reg, vmask);
        asc_mul(t_reg, x0_reg, w_reg, vmask);
        asc_mul(w_reg, t_reg, x1_reg, vmask);
        asc_store(z_local + i * one_rep_size, w_reg);
    }
}

__vector__ __global__ __aicore__ void swi_glu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x0_local[TILE_ELEMS];
    __ubuf__ float x1_local[TILE_ELEMS];
    __ubuf__ float z_local[TILE_ELEMS];
    for (uint32_t g = 0; g < GROUP_NUM; ++g) {
        for (uint32_t r = 0; r < GROUP_ROWS; ++r) {
            const uint32_t row = g * GROUP_ROWS + r;
            asc_copy_gm2ub(x0_local + r * HALF_COL, x + row * FULL_COL, HALF_BYTES);
            asc_copy_gm2ub(x1_local + r * HALF_COL, x + row * FULL_COL + HALF_COL, HALF_BYTES);
        }
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        swi_glu_f32_vf(x0_local, x1_local, z_local, TILE_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        for (uint32_t r = 0; r < GROUP_ROWS; ++r) {
            const uint32_t row = g * GROUP_ROWS + r;
            asc_copy_ub2gm(z + row * HALF_COL, z_local + r * HALF_COL, HALF_BYTES);
        }
        asc_sync_pipe(PIPE_ALL);
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t TILE_ELEMS = 8192u;
constexpr uint32_t TILE_BYTES = TILE_ELEMS * sizeof(float);
constexpr uint32_t TILE_NUM = TOTAL_ELEMS / TILE_ELEMS;

__simd_vf__ inline void exp_f32_vf(__ubuf__ float* x_local, __ubuf__ float* z_local, uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask;
    vector_float x_reg;
    vector_float t_reg;
    vector_float z_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(x_reg, x_local + i * one_rep_size);
        asc_mul_scalar(t_reg, x_reg, 1.5f, vmask);
        asc_exp(z_reg, t_reg, vmask);
        asc_store(z_local + i * one_rep_size, z_reg);
    }
}

__vector__ __global__ __aicore__ void exp_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x_local[TILE_ELEMS];
    __ubuf__ float z_local[TILE_ELEMS];
    for (uint32_t t = 0; t < TILE_NUM; ++t) {
        asc_copy_gm2ub(x_local, x + t * TILE_ELEMS, TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        exp_f32_vf(x_local, z_local, TILE_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + t * TILE_ELEMS, z_local, TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

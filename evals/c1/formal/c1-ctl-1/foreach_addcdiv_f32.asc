#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_ELEMS = 2u * 1024u * 1024u;
constexpr uint32_t TILE_ELEMS = 8192u;
constexpr uint32_t TILE_BYTES = TILE_ELEMS * sizeof(float);
constexpr uint32_t TILE_NUM = TOTAL_ELEMS / TILE_ELEMS;

__simd_vf__ inline void foreach_addcdiv_f32_vf(__ubuf__ float* x1_local, __ubuf__ float* x2_local,
                                                __ubuf__ float* x3_local, __ubuf__ float* z_local,
                                                uint32_t data_len)
{
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = (data_len + one_rep_size - 1) / one_rep_size;

    vector_bool vmask;
    vector_float a_reg;
    vector_float b_reg;
    vector_float c_reg;
    vector_float t_reg;
    vector_float z_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_load(a_reg, x1_local + i * one_rep_size);
        asc_load(b_reg, x2_local + i * one_rep_size);
        asc_load(c_reg, x3_local + i * one_rep_size);
        asc_div(t_reg, b_reg, c_reg, vmask);
        asc_add(z_reg, a_reg, t_reg, vmask);
        asc_store(z_local + i * one_rep_size, z_reg);
    }
}

__vector__ __global__ __aicore__ void foreach_addcdiv_f32(__gm__ float* x1, __gm__ float* x2,
                                                          __gm__ float* x3, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x1_local[TILE_ELEMS];
    __ubuf__ float x2_local[TILE_ELEMS];
    __ubuf__ float x3_local[TILE_ELEMS];
    __ubuf__ float z_local[TILE_ELEMS];
    for (uint32_t t = 0; t < TILE_NUM; ++t) {
        asc_copy_gm2ub(x1_local, x1 + t * TILE_ELEMS, TILE_BYTES);
        asc_copy_gm2ub(x2_local, x2 + t * TILE_ELEMS, TILE_BYTES);
        asc_copy_gm2ub(x3_local, x3 + t * TILE_ELEMS, TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        foreach_addcdiv_f32_vf(x1_local, x2_local, x3_local, z_local, TILE_ELEMS);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + t * TILE_ELEMS, z_local, TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

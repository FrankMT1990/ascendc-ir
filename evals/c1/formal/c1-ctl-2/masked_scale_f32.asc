#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t MS_TOTAL_ELEMS = 2048U * 2048U;
constexpr uint32_t MS_TILE_ELEMS = 8192U;
constexpr uint32_t MS_MASK_TILE_BYTES = MS_TILE_ELEMS / 2U;

__simd_vf__ inline void masked_scale_f32_vf(__ubuf__ float* z, __ubuf__ float* x,
                                            __ubuf__ uint32_t* mp, uint32_t data_len,
                                            uint16_t elems_vl, uint16_t mask_rep)
{
    uint32_t remain = data_len;
    for (uint32_t i = 0; i < data_len; i += elems_vl) {
        uint32_t mlen = remain > (uint32_t)elems_vl ? (uint32_t)elems_vl : remain;
        vector_bool vmask = asc_update_mask_b32(mlen);
        vector_bool pred;
        vector_float xr;
        vector_float zero;
        vector_float yr;
        asc_loadalign_postupdate(pred, mp, mask_rep);
        asc_load(xr, x + i);
        asc_duplicate_scalar(zero, 0.0f, vmask);
        asc_select(yr, xr, zero, pred);
        asc_store(z + i, yr);
        remain = remain > (uint32_t)elems_vl ? remain - (uint32_t)elems_vl : 0U;
    }
}

__vector__ __global__ __aicore__ void masked_scale_f32(__gm__ float* x, __gm__ uint8_t* mask, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x_local[MS_TILE_ELEMS];
    __ubuf__ uint32_t m_local[MS_MASK_TILE_BYTES / 4U];
    __ubuf__ float z_local[MS_TILE_ELEMS];
    uint16_t elems_vl = asc_get_vf_len() / sizeof(float);
    uint16_t mask_rep = asc_get_vf_len() / 8U;
    uint32_t done = 0U;
    while (done < MS_TOTAL_ELEMS) {
        uint32_t n = MS_TOTAL_ELEMS - done;
        n = n > MS_TILE_ELEMS ? MS_TILE_ELEMS : n;
        uint32_t bytes = n * 4U;
        uint32_t mask_bytes = n / 2U;
        asc_copy_gm2ub(x_local, x + done, bytes);
        asc_copy_gm2ub(m_local, mask + done / 2U, mask_bytes);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        masked_scale_f32_vf(z_local, x_local, m_local, n, elems_vl, mask_rep);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + done, z_local, bytes);
        asc_sync_pipe(PIPE_ALL);
        done += n;
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t GELU_TOTAL_ELEMS = 8192U * 8192U;
constexpr uint32_t GELU_TILE_ELEMS = 8192U;

__simd_vf__ inline void gelu_f32_vf(__ubuf__ float* z, __ubuf__ float* x,
                                    uint32_t data_len, uint16_t elems_vl)
{
    uint32_t remain = data_len;
    for (uint32_t i = 0; i < data_len; i += elems_vl) {
        uint32_t mlen = remain > (uint32_t)elems_vl ? (uint32_t)elems_vl : remain;
        vector_bool vmask = asc_update_mask_b32(mlen);
        vector_float xr;
        vector_float x2;
        vector_float x3;
        vector_float c;
        vector_float t;
        vector_float u;
        vector_float w;
        vector_float e;
        vector_float d;
        vector_float two;
        vector_float q;
        vector_float one;
        vector_float th;
        vector_float v;
        vector_float m;
        vector_float yr;
        asc_load(xr, x + i);
        asc_mul(x2, xr, xr, vmask);
        asc_mul(x3, x2, xr, vmask);
        asc_mul_scalar(c, x3, 0.044715f, vmask);
        asc_add(t, xr, c, vmask);
        asc_mul_scalar(u, t, 0.7978845608f, vmask);
        asc_mul_scalar(w, u, 2.0f, vmask);
        asc_exp(e, w, vmask);
        asc_add_scalar(d, e, 1.0f, vmask);
        asc_duplicate_scalar(two, 2.0f, vmask);
        asc_div(q, two, d, vmask);
        asc_duplicate_scalar(one, 1.0f, vmask);
        asc_sub(th, one, q, vmask);
        asc_add_scalar(v, th, 1.0f, vmask);
        asc_mul(m, xr, v, vmask);
        asc_mul_scalar(yr, m, 0.5f, vmask);
        asc_store(z + i, yr);
        remain = remain > (uint32_t)elems_vl ? remain - (uint32_t)elems_vl : 0U;
    }
}

__vector__ __global__ __aicore__ void gelu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x_local[GELU_TILE_ELEMS];
    __ubuf__ float z_local[GELU_TILE_ELEMS];
    uint16_t elems_vl = asc_get_vf_len() / sizeof(float);
    uint32_t done = 0U;
    while (done < GELU_TOTAL_ELEMS) {
        uint32_t n = GELU_TOTAL_ELEMS - done;
        n = n > GELU_TILE_ELEMS ? GELU_TILE_ELEMS : n;
        uint32_t bytes = n * 4U;
        asc_copy_gm2ub(x_local, x + done, bytes);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        gelu_f32_vf(z_local, x_local, n, elems_vl);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + done, z_local, bytes);
        asc_sync_pipe(PIPE_ALL);
        done += n;
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t MISH_TOTAL_ELEMS = 2048U * 2048U;
constexpr uint32_t MISH_TILE_ELEMS = 8192U;

__simd_vf__ inline void mish_f32_vf(__ubuf__ float* z, __ubuf__ float* x,
                                    uint32_t data_len, uint16_t elems_vl)
{
    uint32_t remain = data_len;
    for (uint32_t i = 0; i < data_len; i += elems_vl) {
        uint32_t mlen = remain > (uint32_t)elems_vl ? (uint32_t)elems_vl : remain;
        vector_bool vmask = asc_update_mask_b32(mlen);
        vector_float xr;
        vector_float e;
        vector_float s;
        vector_float l;
        vector_float w;
        vector_float e2;
        vector_float d;
        vector_float two;
        vector_float q;
        vector_float one;
        vector_float th;
        vector_float yr;
        asc_load(xr, x + i);
        asc_exp(e, xr, vmask);
        asc_add_scalar(s, e, 1.0f, vmask);
        asc_ln(l, s, vmask);
        asc_mul_scalar(w, l, 2.0f, vmask);
        asc_exp(e2, w, vmask);
        asc_add_scalar(d, e2, 1.0f, vmask);
        asc_duplicate_scalar(two, 2.0f, vmask);
        asc_div(q, two, d, vmask);
        asc_duplicate_scalar(one, 1.0f, vmask);
        asc_sub(th, one, q, vmask);
        asc_mul(yr, xr, th, vmask);
        asc_store(z + i, yr);
        remain = remain > (uint32_t)elems_vl ? remain - (uint32_t)elems_vl : 0U;
    }
}

__vector__ __global__ __aicore__ void mish_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x_local[MISH_TILE_ELEMS];
    __ubuf__ float z_local[MISH_TILE_ELEMS];
    uint16_t elems_vl = asc_get_vf_len() / sizeof(float);
    uint32_t done = 0U;
    while (done < MISH_TOTAL_ELEMS) {
        uint32_t n = MISH_TOTAL_ELEMS - done;
        n = n > MISH_TILE_ELEMS ? MISH_TILE_ELEMS : n;
        uint32_t bytes = n * 4U;
        asc_copy_gm2ub(x_local, x + done, bytes);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        mish_f32_vf(z_local, x_local, n, elems_vl);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + done, z_local, bytes);
        asc_sync_pipe(PIPE_ALL);
        done += n;
    }
}

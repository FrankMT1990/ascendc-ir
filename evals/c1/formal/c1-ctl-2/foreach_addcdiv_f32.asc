#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t FA_TOTAL_ELEMS = 2U * 1024U * 1024U;
constexpr uint32_t FA_TILE_ELEMS = 8192U;

__simd_vf__ inline void foreach_addcdiv_f32_vf(__ubuf__ float* z, __ubuf__ float* x1,
                                               __ubuf__ float* x2, __ubuf__ float* x3,
                                               uint32_t data_len, uint16_t elems_vl)
{
    uint32_t remain = data_len;
    for (uint32_t i = 0; i < data_len; i += elems_vl) {
        uint32_t mlen = remain > (uint32_t)elems_vl ? (uint32_t)elems_vl : remain;
        vector_bool vmask = asc_update_mask_b32(mlen);
        vector_float a1;
        vector_float a2;
        vector_float a3;
        vector_float q;
        vector_float t;
        vector_float yr;
        asc_load(a1, x1 + i);
        asc_load(a2, x2 + i);
        asc_load(a3, x3 + i);
        asc_div(q, a2, a3, vmask);
        asc_mul_scalar(t, q, 1.0f, vmask);
        asc_add(yr, a1, t, vmask);
        asc_store(z + i, yr);
        remain = remain > (uint32_t)elems_vl ? remain - (uint32_t)elems_vl : 0U;
    }
}

__vector__ __global__ __aicore__ void foreach_addcdiv_f32(__gm__ float* x1, __gm__ float* x2, __gm__ float* x3, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x1_local[FA_TILE_ELEMS];
    __ubuf__ float x2_local[FA_TILE_ELEMS];
    __ubuf__ float x3_local[FA_TILE_ELEMS];
    __ubuf__ float z_local[FA_TILE_ELEMS];
    uint16_t elems_vl = asc_get_vf_len() / sizeof(float);
    uint32_t done = 0U;
    while (done < FA_TOTAL_ELEMS) {
        uint32_t n = FA_TOTAL_ELEMS - done;
        n = n > FA_TILE_ELEMS ? FA_TILE_ELEMS : n;
        uint32_t bytes = n * 4U;
        asc_copy_gm2ub(x1_local, x1 + done, bytes);
        asc_copy_gm2ub(x2_local, x2 + done, bytes);
        asc_copy_gm2ub(x3_local, x3 + done, bytes);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        foreach_addcdiv_f32_vf(z_local, x1_local, x2_local, x3_local, n, elems_vl);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + done, z_local, bytes);
        asc_sync_pipe(PIPE_ALL);
        done += n;
    }
}

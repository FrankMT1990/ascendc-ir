#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t SG_ROWS = 2048U;
constexpr uint32_t SG_HALF = 2048U;
constexpr uint32_t SG_ROW_ELEMS = SG_HALF * 2U;
constexpr uint32_t SG_TILE_ROWS = 2U;
constexpr uint32_t SG_TILE_IN_ELEMS = SG_TILE_ROWS * SG_ROW_ELEMS;
constexpr uint32_t SG_TILE_OUT_ELEMS = SG_TILE_ROWS * SG_HALF;

__simd_vf__ inline void swi_glu_f32_vf(__ubuf__ float* z, __ubuf__ float* x,
                                       uint32_t out_len, uint32_t half, uint16_t elems_vl)
{
    uint32_t remain = out_len;
    uint32_t rows = out_len / half;
    for (uint32_t r = 0; r < rows; ++r) {
        __ubuf__ float* x0 = x + r * half * 2U;
        __ubuf__ float* x1 = x0 + half;
        __ubuf__ float* zr = z + r * half;
        for (uint32_t j = 0; j < half; j += elems_vl) {
            uint32_t mlen = remain > (uint32_t)elems_vl ? (uint32_t)elems_vl : remain;
            vector_bool vmask = asc_update_mask_b32(mlen);
            vector_float a;
            vector_float b;
            vector_float t;
            vector_float e;
            vector_float s;
            vector_float one;
            vector_float sg;
            vector_float p;
            vector_float yr;
            asc_load(a, x0 + j);
            asc_load(b, x1 + j);
            asc_neg(t, a, vmask);
            asc_exp(e, t, vmask);
            asc_add_scalar(s, e, 1.0f, vmask);
            asc_duplicate_scalar(one, 1.0f, vmask);
            asc_div(sg, one, s, vmask);
            asc_mul(p, a, sg, vmask);
            asc_mul(yr, p, b, vmask);
            asc_store(zr + j, yr);
            remain = remain > (uint32_t)elems_vl ? remain - (uint32_t)elems_vl : 0U;
        }
    }
}

__vector__ __global__ __aicore__ void swi_glu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x_local[SG_TILE_IN_ELEMS];
    __ubuf__ float z_local[SG_TILE_OUT_ELEMS];
    uint16_t elems_vl = asc_get_vf_len() / sizeof(float);
    uint32_t row_done = 0U;
    while (row_done < SG_ROWS) {
        uint32_t rt = SG_ROWS - row_done;
        rt = rt > SG_TILE_ROWS ? SG_TILE_ROWS : rt;
        uint32_t in_bytes = rt * SG_ROW_ELEMS * 4U;
        uint32_t out_bytes = rt * SG_HALF * 4U;
        asc_copy_gm2ub(x_local, x + row_done * SG_ROW_ELEMS, in_bytes);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        swi_glu_f32_vf(z_local, x_local, rt * SG_HALF, SG_HALF, elems_vl);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + row_done * SG_HALF, z_local, out_bytes);
        asc_sync_pipe(PIPE_ALL);
        row_done += rt;
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

__simd_vf__ inline void masked_scale_f32_vf(__ubuf__ float* out, __ubuf__ float* in, __ubuf__ uint32_t* mp,
                                            uint32_t n, uint16_t vf, uint16_t mrep)
{
    vector_float x_reg;
    vector_float zero_reg;
    vector_float y_reg;
    vector_bool pred;
    uint32_t cnt = vf;
    for (uint32_t off = 0; off < n; off += vf) {
        vector_bool vmask = asc_update_mask_b32(cnt);
        cnt = vf;
        asc_loadalign_postupdate(pred, mp, mrep);
        asc_load(x_reg, in + off);
        asc_duplicate_scalar(zero_reg, 0.0f, vmask);
        asc_select(y_reg, x_reg, zero_reg, pred);
        asc_store(out + off, y_reg);
    }
}

__vector__ __global__ __aicore__ void masked_scale_f32(__gm__ float* x, __gm__ uint8_t* mask, __gm__ float* z)
{
    asc_init();
    __ubuf__ float in_local[8192];
    __ubuf__ uint32_t mask_local[1024];
    __ubuf__ float out_local[8192];
    uint16_t vf = asc_get_vf_len() / sizeof(float);
    uint16_t mrep = asc_get_vf_len() / 8;
    for (uint32_t base = 0; base < 4194304; base += 8192) {
        asc_copy_gm2ub(in_local, x + base, 8192 * sizeof(float));
        asc_copy_gm2ub(mask_local, mask + base / 2, 4096);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        masked_scale_f32_vf(out_local, in_local, mask_local, 8192, vf, mrep);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + base, out_local, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
    }
    asc_sync_pipe(PIPE_ALL);
}

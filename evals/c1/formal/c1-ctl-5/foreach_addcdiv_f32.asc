#include <cstdint>
#include "c_api/asc_simd.h"

__simd_vf__ inline void foreach_addcdiv_f32_vf(__ubuf__ float* out, __ubuf__ float* in1, __ubuf__ float* in2,
                                               __ubuf__ float* in3, uint32_t n, uint16_t vf)
{
    vector_float a_reg;
    vector_float b_reg;
    vector_float c_reg;
    vector_float q_reg;
    vector_float y_reg;
    uint32_t cnt = vf;
    for (uint32_t off = 0; off < n; off += vf) {
        vector_bool vmask = asc_update_mask_b32(cnt);
        cnt = vf;
        asc_load(a_reg, in1 + off);
        asc_load(b_reg, in2 + off);
        asc_load(c_reg, in3 + off);
        asc_div(q_reg, b_reg, c_reg, vmask);
        asc_add(y_reg, a_reg, q_reg, vmask);
        asc_store(out + off, y_reg);
    }
}

__vector__ __global__ __aicore__ void foreach_addcdiv_f32(__gm__ float* x1, __gm__ float* x2, __gm__ float* x3,
                                                          __gm__ float* z)
{
    asc_init();
    __ubuf__ float x1_local[8192];
    __ubuf__ float x2_local[8192];
    __ubuf__ float x3_local[8192];
    __ubuf__ float out_local[8192];
    uint16_t vf = asc_get_vf_len() / sizeof(float);
    for (uint32_t base = 0; base < 2097152; base += 8192) {
        asc_copy_gm2ub(x1_local, x1 + base, 8192 * sizeof(float));
        asc_copy_gm2ub(x2_local, x2 + base, 8192 * sizeof(float));
        asc_copy_gm2ub(x3_local, x3 + base, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        foreach_addcdiv_f32_vf(out_local, x1_local, x2_local, x3_local, 8192, vf);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + base, out_local, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
    }
    asc_sync_pipe(PIPE_ALL);
}

#include <cstdint>
#include "c_api/asc_simd.h"

__simd_vf__ inline void exp_f32_vf(__ubuf__ float* out, __ubuf__ float* in, uint32_t n, uint16_t vf)
{
    vector_float x_reg;
    vector_float t_reg;
    vector_float y_reg;
    uint32_t cnt = vf;
    for (uint32_t off = 0; off < n; off += vf) {
        vector_bool vmask = asc_update_mask_b32(cnt);
        cnt = vf;
        asc_load(x_reg, in + off);
        asc_mul_scalar(t_reg, x_reg, 1.5f, vmask);
        asc_exp(y_reg, t_reg, vmask);
        asc_store(out + off, y_reg);
    }
}

__vector__ __global__ __aicore__ void exp_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float in_local[8192];
    __ubuf__ float out_local[8192];
    uint16_t vf = asc_get_vf_len() / sizeof(float);
    for (uint32_t base = 0; base < 4194304; base += 8192) {
        asc_copy_gm2ub(in_local, x + base, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        exp_f32_vf(out_local, in_local, 8192, vf);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + base, out_local, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
    }
    asc_sync_pipe(PIPE_ALL);
}

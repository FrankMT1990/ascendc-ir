#include <cstdint>
#include "c_api/asc_simd.h"

__simd_vf__ inline void gelu_f32_vf(__ubuf__ float* out, __ubuf__ float* in, uint32_t n, uint16_t vf)
{
    vector_float x_reg;
    vector_float sq_reg;
    vector_float cu_reg;
    vector_float k_reg;
    vector_float inner_reg;
    vector_float z_reg;
    vector_float z2_reg;
    vector_float e_reg;
    vector_float d_reg;
    vector_float two_reg;
    vector_float q_reg;
    vector_float one_reg;
    vector_float th_reg;
    vector_float s_reg;
    vector_float hf_reg;
    vector_float y_reg;
    uint32_t cnt = vf;
    for (uint32_t off = 0; off < n; off += vf) {
        vector_bool vmask = asc_update_mask_b32(cnt);
        cnt = vf;
        asc_load(x_reg, in + off);
        asc_mul(sq_reg, x_reg, x_reg, vmask);
        asc_mul(cu_reg, sq_reg, x_reg, vmask);
        asc_mul_scalar(k_reg, cu_reg, 0.044715f, vmask);
        asc_add(inner_reg, x_reg, k_reg, vmask);
        asc_mul_scalar(z_reg, inner_reg, 0.7978845608f, vmask);
        asc_add(z2_reg, z_reg, z_reg, vmask);
        asc_exp(e_reg, z2_reg, vmask);
        asc_add_scalar(d_reg, e_reg, 1.0f, vmask);
        asc_duplicate_scalar(two_reg, 2.0f, vmask);
        asc_div(q_reg, two_reg, d_reg, vmask);
        asc_duplicate_scalar(one_reg, 1.0f, vmask);
        asc_sub(th_reg, one_reg, q_reg, vmask);
        asc_add_scalar(s_reg, th_reg, 1.0f, vmask);
        asc_mul_scalar(hf_reg, x_reg, 0.5f, vmask);
        asc_mul(y_reg, hf_reg, s_reg, vmask);
        asc_store(out + off, y_reg);
    }
}

__vector__ __global__ __aicore__ void gelu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float in_local[8192];
    __ubuf__ float out_local[8192];
    uint16_t vf = asc_get_vf_len() / sizeof(float);
    for (uint32_t base = 0; base < 67108864; base += 8192) {
        asc_copy_gm2ub(in_local, x + base, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        gelu_f32_vf(out_local, in_local, 8192, vf);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + base, out_local, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
    }
    asc_sync_pipe(PIPE_ALL);
}

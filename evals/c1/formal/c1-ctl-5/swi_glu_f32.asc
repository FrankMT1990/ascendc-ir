#include <cstdint>
#include "c_api/asc_simd.h"

__simd_vf__ inline void swi_glu_f32_vf(__ubuf__ float* out, __ubuf__ float* in0, __ubuf__ float* in1,
                                       uint32_t n, uint16_t vf)
{
    vector_float a_reg;
    vector_float b_reg;
    vector_float ng_reg;
    vector_float e_reg;
    vector_float d_reg;
    vector_float one_reg;
    vector_float sg_reg;
    vector_float p_reg;
    vector_float y_reg;
    uint32_t cnt = vf;
    for (uint32_t off = 0; off < n; off += vf) {
        vector_bool vmask = asc_update_mask_b32(cnt);
        cnt = vf;
        asc_load(a_reg, in0 + off);
        asc_load(b_reg, in1 + off);
        asc_neg(ng_reg, a_reg, vmask);
        asc_exp(e_reg, ng_reg, vmask);
        asc_add_scalar(d_reg, e_reg, 1.0f, vmask);
        asc_duplicate_scalar(one_reg, 1.0f, vmask);
        asc_div(sg_reg, one_reg, d_reg, vmask);
        asc_mul(p_reg, a_reg, sg_reg, vmask);
        asc_mul(y_reg, p_reg, b_reg, vmask);
        asc_store(out + off, y_reg);
    }
}

__vector__ __global__ __aicore__ void swi_glu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float x0_local[8192];
    __ubuf__ float x1_local[8192];
    __ubuf__ float y_local[8192];
    uint16_t vf = asc_get_vf_len() / sizeof(float);
    for (uint32_t r = 0; r < 2048; r += 4) {
        for (uint32_t k = 0; k < 4; ++k) {
            uint32_t row = r + k;
            asc_copy_gm2ub(x0_local + k * 2048, x + row * 4096, 2048 * sizeof(float));
            asc_copy_gm2ub(x1_local + k * 2048, x + row * 4096 + 2048, 2048 * sizeof(float));
        }
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        swi_glu_f32_vf(y_local, x0_local, x1_local, 8192, vf);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + r * 2048, y_local, 8192 * sizeof(float));
        asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
        asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID2);
    }
    asc_sync_pipe(PIPE_ALL);
}

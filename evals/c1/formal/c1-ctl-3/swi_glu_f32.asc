#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t SG_ROWS = 2048u;
constexpr uint32_t SG_HALF = 2048u;
constexpr uint32_t SG_TILE_ROWS = 2u;
constexpr uint32_t SG_TILES = SG_ROWS / SG_TILE_ROWS;
constexpr uint32_t SG_X_TILE_ELEMS = SG_TILE_ROWS * 2u * SG_HALF;
constexpr uint32_t SG_Z_TILE_ELEMS = SG_TILE_ROWS * SG_HALF;
constexpr uint32_t SG_X_TILE_BYTES = SG_X_TILE_ELEMS * 4u;
constexpr uint32_t SG_Z_TILE_BYTES = SG_Z_TILE_ELEMS * 4u;

__simd_vf__ inline void swi_glu_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                   uint32_t rows, uint32_t row_half, uint32_t vf_len)
{
    vector_float x0r;
    vector_float x1r;
    vector_float nr;
    vector_float er;
    vector_float ur;
    vector_float onesr;
    vector_float sr;
    vector_float tr;
    vector_float yr;
    vector_bool vmask;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t z_count = rows * row_half;
    uint32_t blocks_per_row = row_half / vf_elems;
    uint32_t remaining = z_count;
    uint32_t blocks = (z_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        uint32_t row = b / blocks_per_row;
        uint32_t col = b - row * blocks_per_row;
        uint32_t x0_off = row * (row_half + row_half) + col * vf_elems;
        uint32_t x1_off = x0_off + row_half;
        vmask = asc_update_mask_b32(remaining);
        asc_load(x0r, src + x0_off);
        asc_load(x1r, src + x1_off);
        asc_neg(nr, x0r, vmask);
        asc_exp(er, nr, vmask);
        asc_add_scalar(ur, er, 1.0f, vmask);
        asc_duplicate_scalar(onesr, 1.0f, vmask);
        asc_div(sr, onesr, ur, vmask);
        asc_mul(tr, x0r, sr, vmask);
        asc_mul(yr, tr, x1r, vmask);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void swi_glu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float xub[SG_X_TILE_ELEMS];
    __ubuf__ float zub[SG_Z_TILE_ELEMS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < SG_TILES; ++t) {
        asc_copy_gm2ub(xub, x + t * SG_X_TILE_ELEMS, SG_X_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        swi_glu_vf(zub, xub, SG_TILE_ROWS, SG_HALF, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * SG_Z_TILE_ELEMS, zub, SG_Z_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

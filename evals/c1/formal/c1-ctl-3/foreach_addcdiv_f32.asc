#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t FA_TOTAL_ELEMS = 2u * 1024u * 1024u;
constexpr uint32_t FA_TILE_ELEMS = 8192u;
constexpr uint32_t FA_TILE_BYTES = FA_TILE_ELEMS * 4u;
constexpr uint32_t FA_TILE_COUNT = FA_TOTAL_ELEMS / FA_TILE_ELEMS;

__simd_vf__ inline void addcdiv_vf(__ubuf__ float* dst, __ubuf__ float* src1,
                                   __ubuf__ float* src2, __ubuf__ float* src3,
                                   uint32_t elem_count, uint32_t vf_len)
{
    vector_float r1;
    vector_float r2;
    vector_float r3;
    vector_float qr;
    vector_float yr;
    vector_bool vmask;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t remaining = elem_count;
    uint32_t blocks = (elem_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        vmask = asc_update_mask_b32(remaining);
        asc_load(r1, src1 + b * vf_elems);
        asc_load(r2, src2 + b * vf_elems);
        asc_load(r3, src3 + b * vf_elems);
        asc_div(qr, r2, r3, vmask);
        asc_add(yr, r1, qr, vmask);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void foreach_addcdiv_f32(__gm__ float* x1, __gm__ float* x2,
                                                          __gm__ float* x3, __gm__ float* z)
{
    asc_init();
    __ubuf__ float u1[FA_TILE_ELEMS];
    __ubuf__ float u2[FA_TILE_ELEMS];
    __ubuf__ float u3[FA_TILE_ELEMS];
    __ubuf__ float uz[FA_TILE_ELEMS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < FA_TILE_COUNT; ++t) {
        asc_copy_gm2ub(u1, x1 + t * FA_TILE_ELEMS, FA_TILE_BYTES);
        asc_copy_gm2ub(u2, x2 + t * FA_TILE_ELEMS, FA_TILE_BYTES);
        asc_copy_gm2ub(u3, x3 + t * FA_TILE_ELEMS, FA_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        addcdiv_vf(uz, u1, u2, u3, FA_TILE_ELEMS, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * FA_TILE_ELEMS, uz, FA_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t MISH_TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t MISH_TILE_ELEMS = 8192u;
constexpr uint32_t MISH_TILE_BYTES = MISH_TILE_ELEMS * 4u;
constexpr uint32_t MISH_TILE_COUNT = MISH_TOTAL_ELEMS / MISH_TILE_ELEMS;

__simd_vf__ inline void mish_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                uint32_t elem_count, uint32_t vf_len)
{
    vector_float xr;
    vector_float er;
    vector_float ur;
    vector_float zr;
    vector_float z2r;
    vector_float e2r;
    vector_float u2r;
    vector_float vr;
    vector_float wr;
    vector_float yr;
    vector_float onesr;
    vector_float twosr;
    vector_bool vmask;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t remaining = elem_count;
    uint32_t blocks = (elem_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        vmask = asc_update_mask_b32(remaining);
        asc_load(xr, src + b * vf_elems);
        asc_exp(er, xr, vmask);
        asc_add_scalar(ur, er, 1.0f, vmask);
        asc_ln(zr, ur, vmask);
        asc_mul_scalar(z2r, zr, 2.0f, vmask);
        asc_exp(e2r, z2r, vmask);
        asc_add_scalar(u2r, e2r, 1.0f, vmask);
        asc_duplicate_scalar(twosr, 2.0f, vmask);
        asc_div(vr, twosr, u2r, vmask);
        asc_duplicate_scalar(onesr, 1.0f, vmask);
        asc_sub(wr, onesr, vr, vmask);
        asc_mul(yr, xr, wr, vmask);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void mish_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float xub[MISH_TILE_ELEMS];
    __ubuf__ float zub[MISH_TILE_ELEMS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < MISH_TILE_COUNT; ++t) {
        asc_copy_gm2ub(xub, x + t * MISH_TILE_ELEMS, MISH_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        mish_vf(zub, xub, MISH_TILE_ELEMS, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * MISH_TILE_ELEMS, zub, MISH_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

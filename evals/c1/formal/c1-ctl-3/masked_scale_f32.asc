#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t MS_TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t MS_TILE_ELEMS = 8192u;
constexpr uint32_t MS_TILE_BYTES = MS_TILE_ELEMS * 4u;
constexpr uint32_t MS_TILE_COUNT = MS_TOTAL_ELEMS / MS_TILE_ELEMS;
constexpr uint32_t MS_MASK_TILE_BYTES = MS_TILE_ELEMS * 4u / 8u;
constexpr uint32_t MS_MASK_TILE_WORDS = MS_MASK_TILE_BYTES / 4u;

__simd_vf__ inline void masked_scale_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                        __ubuf__ uint32_t* pred_src, uint32_t elem_count,
                                        uint32_t vf_len)
{
    vector_float xr;
    vector_float yr;
    vector_float zeror;
    vector_bool vmask;
    vector_bool pred;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t mask_rep = vf_len / 8u;
    uint32_t remaining = elem_count;
    uint32_t blocks = (elem_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        vmask = asc_update_mask_b32(remaining);
        asc_loadalign_postupdate(pred, pred_src, mask_rep);
        asc_load(xr, src + b * vf_elems);
        asc_duplicate_scalar(zeror, 0.0f, vmask);
        asc_select(yr, xr, zeror, pred);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void masked_scale_f32(__gm__ float* x, __gm__ uint8_t* mask,
                                                       __gm__ float* z)
{
    asc_init();
    __ubuf__ float xub[MS_TILE_ELEMS];
    __ubuf__ float zub[MS_TILE_ELEMS];
    __ubuf__ uint32_t pred_ub[MS_MASK_TILE_WORDS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < MS_TILE_COUNT; ++t) {
        asc_copy_gm2ub(xub, x + t * MS_TILE_ELEMS, MS_TILE_BYTES);
        asc_copy_gm2ub(pred_ub, mask + t * MS_MASK_TILE_BYTES, MS_MASK_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        masked_scale_vf(zub, xub, pred_ub, MS_TILE_ELEMS, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * MS_TILE_ELEMS, zub, MS_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

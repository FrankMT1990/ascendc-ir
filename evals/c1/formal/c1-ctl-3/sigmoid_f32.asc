#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t SIG_TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t SIG_TILE_ELEMS = 8192u;
constexpr uint32_t SIG_TILE_BYTES = SIG_TILE_ELEMS * 4u;
constexpr uint32_t SIG_TILE_COUNT = SIG_TOTAL_ELEMS / SIG_TILE_ELEMS;

__simd_vf__ inline void sigmoid_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                   uint32_t elem_count, uint32_t vf_len)
{
    vector_float xr;
    vector_float nr;
    vector_float er;
    vector_float ur;
    vector_float onesr;
    vector_float yr;
    vector_bool vmask;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t remaining = elem_count;
    uint32_t blocks = (elem_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        vmask = asc_update_mask_b32(remaining);
        asc_load(xr, src + b * vf_elems);
        asc_neg(nr, xr, vmask);
        asc_exp(er, nr, vmask);
        asc_add_scalar(ur, er, 1.0f, vmask);
        asc_duplicate_scalar(onesr, 1.0f, vmask);
        asc_div(yr, onesr, ur, vmask);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void sigmoid_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float xub[SIG_TILE_ELEMS];
    __ubuf__ float zub[SIG_TILE_ELEMS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < SIG_TILE_COUNT; ++t) {
        asc_copy_gm2ub(xub, x + t * SIG_TILE_ELEMS, SIG_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        sigmoid_vf(zub, xub, SIG_TILE_ELEMS, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * SIG_TILE_ELEMS, zub, SIG_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

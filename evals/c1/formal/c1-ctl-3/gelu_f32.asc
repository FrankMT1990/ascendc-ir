#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t GELU_TOTAL_ELEMS = 8192u * 8192u;
constexpr uint32_t GELU_TILE_ELEMS = 8192u;
constexpr uint32_t GELU_TILE_BYTES = GELU_TILE_ELEMS * 4u;
constexpr uint32_t GELU_TILE_COUNT = GELU_TOTAL_ELEMS / GELU_TILE_ELEMS;

__simd_vf__ inline void gelu_vf(__ubuf__ float* dst, __ubuf__ float* src,
                                uint32_t elem_count, uint32_t vf_len)
{
    vector_float xr;
    vector_float x2r;
    vector_float x3r;
    vector_float tr;
    vector_float ar;
    vector_float zr;
    vector_float z2r;
    vector_float er;
    vector_float ur;
    vector_float vr;
    vector_float wr;
    vector_float sr;
    vector_float hr;
    vector_float yr;
    vector_float onesr;
    vector_float twosr;
    vector_bool vmask;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t remaining = elem_count;
    uint32_t blocks = (elem_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        vmask = asc_update_mask_b32(remaining);
        asc_load(xr, src + b * vf_elems);
        asc_mul(x2r, xr, xr, vmask);
        asc_mul(x3r, x2r, xr, vmask);
        asc_mul_scalar(tr, x3r, 0.044715f, vmask);
        asc_add(ar, xr, tr, vmask);
        asc_mul_scalar(zr, ar, 0.7978845608f, vmask);
        asc_mul_scalar(z2r, zr, 2.0f, vmask);
        asc_exp(er, z2r, vmask);
        asc_add_scalar(ur, er, 1.0f, vmask);
        asc_duplicate_scalar(twosr, 2.0f, vmask);
        asc_div(vr, twosr, ur, vmask);
        asc_duplicate_scalar(onesr, 1.0f, vmask);
        asc_sub(wr, onesr, vr, vmask);
        asc_add_scalar(sr, wr, 1.0f, vmask);
        asc_mul_scalar(hr, xr, 0.5f, vmask);
        asc_mul(yr, hr, sr, vmask);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void gelu_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float xub[GELU_TILE_ELEMS];
    __ubuf__ float zub[GELU_TILE_ELEMS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < GELU_TILE_COUNT; ++t) {
        asc_copy_gm2ub(xub, x + t * GELU_TILE_ELEMS, GELU_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        gelu_vf(zub, xub, GELU_TILE_ELEMS, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * GELU_TILE_ELEMS, zub, GELU_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

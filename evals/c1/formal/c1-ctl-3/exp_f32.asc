#include <cstdint>
#include "c_api/asc_simd.h"

constexpr uint32_t EXP_TOTAL_ELEMS = 2048u * 2048u;
constexpr uint32_t EXP_TILE_ELEMS = 8192u;
constexpr uint32_t EXP_TILE_BYTES = EXP_TILE_ELEMS * 4u;
constexpr uint32_t EXP_TILE_COUNT = EXP_TOTAL_ELEMS / EXP_TILE_ELEMS;

__simd_vf__ inline void exp_vf(__ubuf__ float* dst, __ubuf__ float* src,
                               uint32_t elem_count, uint32_t vf_len)
{
    vector_float xr;
    vector_float tr;
    vector_float yr;
    vector_bool vmask;
    uint32_t vf_elems = vf_len / 4u;
    uint32_t remaining = elem_count;
    uint32_t blocks = (elem_count + vf_elems - 1u) / vf_elems;
    for (uint32_t b = 0; b < blocks; ++b) {
        vmask = asc_update_mask_b32(remaining);
        asc_load(xr, src + b * vf_elems);
        asc_mul_scalar(tr, xr, 1.5f, vmask);
        asc_exp(yr, tr, vmask);
        asc_store(dst + b * vf_elems, yr);
    }
}

__vector__ __global__ __aicore__ void exp_f32(__gm__ float* x, __gm__ float* z)
{
    asc_init();
    __ubuf__ float xub[EXP_TILE_ELEMS];
    __ubuf__ float zub[EXP_TILE_ELEMS];
    uint32_t vf_len = asc_get_vf_len();
    for (uint32_t t = 0; t < EXP_TILE_COUNT; ++t) {
        asc_copy_gm2ub(xub, x + t * EXP_TILE_ELEMS, EXP_TILE_BYTES);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        exp_vf(zub, xub, EXP_TILE_ELEMS, vf_len);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID1);
        asc_copy_ub2gm(z + t * EXP_TILE_ELEMS, zub, EXP_TILE_BYTES);
        asc_sync_pipe(PIPE_ALL);
    }
}

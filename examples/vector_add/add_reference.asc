/*
 * 手写对照：vector add，与 add.py（AscendC-IR）同一调度。
 * 结构参照官方 c_api_delicacy_async_add，两处有意偏差：
 * 1) 单核（官方样例按 asc_get_block_num() 切分；AscendC-IR v0.2 还没有 block 词汇）；
 * 2) x/y 双缓冲（官方样例单缓冲全串行）。
 * M0 配对要求：拷贝、计算、同步边一致，只允许 event 分配在等价类内不同。
 *
 * event 纪律（2026-09-25 评审修正）：event id 按 (生产PIPE, 消费PIPE) 对独立分配；
 * 双缓冲 WAR 按槽位分配 id，保证同一 id 上 notify/wait 严格交替（同一 event 连续
 * notify 是未定义行为）。
 */

#include "c_api/asc_simd.h"

#define TILE 2048
#define TILES 8
#define BLOCK_BYTES 32
#define REPEAT_BYTES 256

__vector__ __global__ __aicore__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();

    __ubuf__ float x_local[2 * TILE];
    __ubuf__ float y_local[2 * TILE];
    __ubuf__ float z_local[TILE];

    for (uint32_t i = 0; i < TILES; i++) {
        // WAR：复用 x/y 槽位前，等两轮前的 v.add 读完；event 按槽位分配
        if (i >= 2) {
            asc_sync_wait(PIPE_V, PIPE_MTE2, (i % 2) == 0 ? EVENT_ID0 : EVENT_ID1);
            asc_sync_wait(PIPE_V, PIPE_MTE2, (i % 2) == 0 ? EVENT_ID2 : EVENT_ID3);
        }
        asc_copy_gm2ub(x_local + (i % 2) * TILE, x + i * TILE, 1, TILE * sizeof(float) / BLOCK_BYTES, 0, 0);
        asc_copy_gm2ub(y_local + (i % 2) * TILE, y + i * TILE, 1, TILE * sizeof(float) / BLOCK_BYTES, 0, 0);

        // 前向：MTE2 搬完通知 V（MTE2→V 对的 event 命名空间独立于 V→MTE2 对）
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        // WAR：覆写 z 前，等上一轮的 mte3 搬完
        if (i >= 1) {
            asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
        }
        asc_add(z_local, x_local + (i % 2) * TILE, y_local + (i % 2) * TILE,
                TILE * sizeof(float) / REPEAT_BYTES, 1, 1, 1, 8, 8, 8);

        // 释放 x/y 槽位给两轮后的 copy
        if (i + 2 < TILES) {
            asc_sync_notify(PIPE_V, PIPE_MTE2, (i % 2) == 0 ? EVENT_ID0 : EVENT_ID1);
            asc_sync_notify(PIPE_V, PIPE_MTE2, (i % 2) == 0 ? EVENT_ID2 : EVENT_ID3);
        }

        // 前向：V 算完通知 MTE3
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + i * TILE, z_local, 1, TILE * sizeof(float) / BLOCK_BYTES, 0, 0);

        // 释放 z 槽位给下一轮 v.add
        if (i + 1 < TILES) {
            asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
        }
    }
}

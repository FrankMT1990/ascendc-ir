/*
 * 手写对照：与 add.py 同一份调度，软件流水。
 * prologue 和 epilogue 直写，稳态循环里没有 if。
 * 拷贝、计算、同步边与生成内核一致。这是 M0 去守卫通过线要对照的那一份。
 */

#include "c_api/asc_simd.h"

__vector__ __global__ __aicore__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();

    __ubuf__ float x_local[4096];
    __ubuf__ float y_local[4096];
    __ubuf__ float z_local[2048];

    // prologue i = 0
    // 槽位 0
    asc_copy_gm2ub(x_local, x, 1, 256, 0, 0);
    asc_copy_gm2ub(y_local, y, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_add(z_local, x_local, y_local, 32, 1, 1, 1, 8, 8, 8);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID2);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z, z_local, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    // 槽位 1
    asc_copy_gm2ub(x_local + 2048, x + 2048, 1, 256, 0, 0);
    asc_copy_gm2ub(y_local + 2048, y + 2048, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_add(z_local, x_local + 2048, y_local + 2048, 32, 1, 1, 1, 8, 8, 8);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID1);
    asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID3);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z + 2048, z_local, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    for (uint32_t i = 2; i < 6; i += 2) {
        // 槽位 0
        asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
        asc_copy_gm2ub(x_local, x + i * 2048, 1, 256, 0, 0);
        asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID2);
        asc_copy_gm2ub(y_local, y + i * 2048, 1, 256, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
        asc_add(z_local, x_local, y_local, 32, 1, 1, 1, 8, 8, 8);
        asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
        asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID2);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + i * 2048, z_local, 1, 256, 0, 0);
        asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
        // 槽位 1
        asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID1);
        asc_copy_gm2ub(x_local + 2048, x + (i + 1) * 2048, 1, 256, 0, 0);
        asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID3);
        asc_copy_gm2ub(y_local + 2048, y + (i + 1) * 2048, 1, 256, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
        asc_add(z_local, x_local + 2048, y_local + 2048, 32, 1, 1, 1, 8, 8, 8);
        asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID1);
        asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID3);
        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(z + (i + 1) * 2048, z_local, 1, 256, 0, 0);
        asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    }
    // epilogue i = 6
    // 槽位 0
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
    asc_copy_gm2ub(x_local, x + 12288, 1, 256, 0, 0);
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID2);
    asc_copy_gm2ub(y_local, y + 12288, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_add(z_local, x_local, y_local, 32, 1, 1, 1, 8, 8, 8);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z + 12288, z_local, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    // 槽位 1
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID1);
    asc_copy_gm2ub(x_local + 2048, x + 14336, 1, 256, 0, 0);
    asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID3);
    asc_copy_gm2ub(y_local + 2048, y + 14336, 1, 256, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_add(z_local, x_local + 2048, y_local + 2048, 32, 1, 1, 1, 8, 8, 8);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(z + 14336, z_local, 1, 256, 0, 0);
}
